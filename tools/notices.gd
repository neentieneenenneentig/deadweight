extends SceneTree
## Writes THIRD_PARTY_NOTICES.txt from the engine's own license data, so the notices always match
## the Godot version the game ships with. Run after every engine upgrade:
##   <godot> --headless --path . --script res://tools/notices.gd

const OUTPUT := "res://THIRD_PARTY_NOTICES.txt"
const RULE := "=============================================================================="
const THIN := "------------------------------------------------------------------------------"


func _init() -> void:
	var lines := PackedStringArray()
	var version: String = Engine.get_version_info().get("string", "")
	lines.append("DEADWEIGHT - third-party notices")
	lines.append("")
	lines.append("All game code, art and audio are original to this project. The game's geometry,")
	lines.append("interface graphics, sound effects and music are generated by its own code. No")
	lines.append("third-party art, music, fonts or plugins are bundled.")
	lines.append("")
	lines.append("DEADWEIGHT is built with the Godot Engine %s (https://godotengine.org)." % version)
	lines.append("Godot is distributed under the MIT license below. It includes the third-party")
	lines.append("components listed after it, each under the license named with it.")
	lines.append("")
	lines.append(RULE)
	lines.append("Godot Engine")
	lines.append(RULE)
	lines.append("")
	lines.append(Engine.get_license_text().strip_edges())
	lines.append("")
	lines.append(RULE)
	lines.append("Third-party components in the Godot Engine")
	lines.append(RULE)
	for component: Dictionary in Engine.get_copyright_info():
		lines.append("")
		lines.append(str(component.get("name", "")))
		for part: Dictionary in component.get("parts", []):
			for holder: String in part.get("copyright", PackedStringArray()):
				lines.append("  Copyright (c) %s" % holder)
			lines.append("  License: %s" % str(part.get("license", "")))
	lines.append("")
	lines.append(RULE)
	lines.append("License texts")
	lines.append(RULE)
	var licenses: Dictionary = Engine.get_license_info()
	var names: Array = licenses.keys()
	names.sort()
	for license_name: String in names:
		lines.append("")
		lines.append(THIN)
		lines.append(license_name)
		lines.append(THIN)
		lines.append("")
		lines.append(str(licenses[license_name]).strip_edges())
	lines.append("")

	var file := FileAccess.open(OUTPUT, FileAccess.WRITE)
	if file == null:
		push_error("Cannot write %s (error %d)" % [OUTPUT, FileAccess.get_open_error()])
		quit(1)
		return
	file.store_string("\n".join(lines))
	file.close()
	print("Wrote %s: %d components, %d license texts." % [OUTPUT, Engine.get_copyright_info().size(), names.size()])
	quit(0)
