extends "res://scripts/ui/screen.gd"
## Credits: the game, "Made with Godot Engine", the engine licence text and the copyright notices
## of every component Godot ships (Engine.get_copyright_info). The body scrolls with the mouse
## wheel, touch drag, the keyboard arrows, the D-pad or either stick while this screen is open.

const SCROLL_SPEED := 760.0
const STICK_DEADZONE := 0.2
const GAME_NOTE := "Every sound, texture and model in DEADWEIGHT is generated by the game's own code. No downloaded assets, fonts or plugins are used."

var _scroll: ScrollContainer
var _back: Button


func build() -> void:
	set_process(true)
	var f: Dictionary = frame("CREDITS", "DEADWEIGHT")
	var body: VBoxContainer = f["body"]
	var card: PanelContainer = panel(body, "GlassSoft")
	card.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_scroll = scroller(card)
	var column: VBoxContainer = vbox(_scroll, 16)
	column.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_add_game(column)
	_add_godot(column)
	_add_licence(column)
	_add_copyright(column)
	_back = footer_controls(f["footer"])


func primary_focus() -> Control:
	return _back


## Scrolls to the end of the credits (previews and tests).
func scroll_to_bottom() -> void:
	if _scroll != null:
		_scroll.scroll_vertical = 1000000


func _process(delta: float) -> void:
	if _scroll == null or not is_visible_in_tree():
		return
	var axis: float = Input.get_action_strength("ui_down") - Input.get_action_strength("ui_up")
	for pad: int in Input.get_connected_joypads():
		var stick: float = Input.get_joy_axis(pad, JOY_AXIS_RIGHT_Y)
		if absf(stick) > STICK_DEADZONE:
			axis += stick
	if absf(axis) > 0.0:
		_scroll.scroll_vertical += roundi(clampf(axis, -1.0, 1.0) * SCROLL_SPEED * delta)


func _add_game(column: VBoxContainer) -> void:
	var card: PanelContainer = panel(column, "Glass")
	var inner: VBoxContainer = vbox(card, 8)
	label(inner, "THE GAME", "Overline")
	label(inner, "DEADWEIGHT  v%s" % str(ProjectSettings.get_setting("application/config/version", "0.0.0")), "H2")
	wrap_label(inner, str(ProjectSettings.get_setting("application/config/description", "")), "Body")
	wrap_label(inner, GAME_NOTE, "BodyMuted")


func _add_godot(column: VBoxContainer) -> void:
	var card: PanelContainer = panel(column, "Glass")
	var inner: VBoxContainer = vbox(card, 8)
	label(inner, "MADE WITH GODOT ENGINE", "OverlineCyan")
	label(inner, "Godot Engine %s" % _engine_version(), "H3")
	wrap_label(inner, "Godot Engine is free and open source software, released under the MIT license.", "BodyMuted")
	label(inner, "godotengine.org", "Caption")


func _add_licence(column: VBoxContainer) -> void:
	var card: PanelContainer = panel(column, "GlassSoft")
	var inner: VBoxContainer = vbox(card, 8)
	label(inner, "ENGINE LICENCE", "Overline")
	wrap_label(inner, Engine.get_license_text(), "Small")


func _add_copyright(column: VBoxContainer) -> void:
	var card: PanelContainer = panel(column, "GlassSoft")
	var inner: VBoxContainer = vbox(card, 12)
	label(inner, "COPYRIGHT NOTICES", "Overline")
	for component: Variant in Engine.get_copyright_info():
		var entry: Dictionary = component
		label(inner, str(entry.get("name", "")), "Body")
		var lines: Array[String] = []
		for part: Variant in entry.get("parts", []):
			for line: Variant in (part as Dictionary).get("copyright", []):
				var text: String = str(line)
				if not text.is_empty() and not lines.has(text):
					lines.append(text)
		if not lines.is_empty():
			wrap_label(inner, "\n".join(PackedStringArray(lines)), "Caption")


func _engine_version() -> String:
	var info: Dictionary = Engine.get_version_info()
	return "%d.%d.%d-%s" % [int(info.get("major", 4)), int(info.get("minor", 0)), int(info.get("patch", 0)), str(info.get("status", "stable"))]
